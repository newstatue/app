{
  "name": "app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "commit": "cz",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply app-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply app-db --remote",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.0",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "^1.5.3",
    "better-sqlite3": "^12.6.2",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.3.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd",
      "better-sqlite3"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}

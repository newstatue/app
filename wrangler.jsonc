{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-db",
      "migrations_dir": "./drizzle",
      "database_id": "ce20fc98-4b8a-4ee1-8534-29a0d40a475e",
      "remote": false
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET"
    ]
  }
}
